const PUBLIC_SETTING_KEYS = ['REGISTRATION_ENABLED','REGISTRATION_START','REGISTRATION_END','TOURNAMENT_NAME','TOURNAMENT_DATES','TOURNAMENT_ORGANISER','PAYMENT_LINK','PAYMENT_QR','PAYMENT_INSTRUCTIONS','WHATSAPP_LINK'];
