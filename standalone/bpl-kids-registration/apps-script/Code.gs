/** Run once from the Apps Script editor. Safe to run again. */
function setupBplRegistration() {
  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const spreadsheet = getOrCreateSpreadsheet_();
    ensureSchema_(spreadsheet);
    ensureSettings_(spreadsheet);
    const result = { success: true, spreadsheetId: spreadsheet.getId(), spreadsheetUrl: spreadsheet.getUrl(), tabs: Object.values(TAB) };
    console.log(JSON.stringify(result));
    return result;
  } finally { lock.releaseLock(); }
}
