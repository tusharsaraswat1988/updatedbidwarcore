  p.setProperties({ SPREADSHEET_ID: spreadsheet.getId(), BPL_OWNED_SPREADSHEET_ID: spreadsheet.getId(), BPL_DEFAULT_SHEET_TO_REMOVE: spreadsheet.getSheets()[0].getSheetName() }, false);
