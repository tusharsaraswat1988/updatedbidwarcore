{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": [
        { "path": "/app/node_modules/.bin" },
        { "src": "package.json", "dest": "package.json" },
        { "src": "pnpm-workspace.yaml", "dest": "pnpm-workspace.yaml" },
        "pnpm install --no-frozen-lockfile"
      ]
    }
  }
}
