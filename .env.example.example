# ==============================================================================
# BIDWAR — Environment Variables Reference (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# For production deployments (Render, Railway, VPS), configure these in your host's
# environment dashboard or refer to `.env.production.example`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME MODE (Required)
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# BidWar environment identity: local | staging | production
# Required: controls OAuth callback guards, cookie domain security, and CORS policies.
BIDWAR_ENV=local

# TCP port the HTTP server listens on (Render/Railway injects PORT automatically)
PORT=3000

# Canonical apex and subdomains (comma-separated, NO scheme, first entry is canonical)
# Production: bidwar.in,www.bidwar.in (both needed for shared apex session cookies)
# Local dev: pnpm dev overrides this dynamically for localhost
APP_DOMAIN=bidwar.in,www.bidwar.in

# Canonical public site URL (scheme + host, NO trailing slash)
# Production: REQUIRED — used for Google OAuth redirect_uri, email links, SMS links
# Local dev: pnpm dev sets this to http://localhost:<WEB_PORT> automatically
APP_URL=https://bidwar.in

# URL scheme for public links when APP_URL is unset (must be https in production)
APP_PUBLIC_SCHEME=https

# Secret key for signing session cookies and JWTs (minimum 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-byte-random-hex-minimum-32-chars

# Master super-admin password for platform administration
ADMIN_PASSWORD=replace-with-strong-password

# Serve pre-built static frontends from the API server (true in production)
SERVE_STATIC=true

# ------------------------------------------------------------------------------
# 2. DATABASE & NEON POSTGRESQL (Required)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string (pooled endpoint, e.g. Neon PgBouncer)
# NEON_DATABASE_URL takes precedence over DATABASE_URL if both are set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Direct (unpooled) PostgreSQL connection string for Postgres LISTEN/NOTIFY and DDL migrations.
# If omitted on Neon, BidWar automatically resolves this by stripping '-pooler.' from the hostname.
# DIRECT_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Maximum connections in the PostgreSQL client pool (default: 20, min: 5, max: 50)
# PG_POOL_MAX=20

# Optional safety allowlists: substrings that MUST match the database host for the environment.
# Protects against accidentally pointing production to staging or staging to production.
# NEON_PRODUCTION_HOST_ALLOWLIST=ep-hidden-band-aogw7hho
# NEON_STAGING_HOST_ALLOWLIST=ep-staging-sample-123456

# Schema auto-heal: validates and migrates missing tables/columns on server boot.
# Recommended: true for local/staging; false or omit in production.
# SCHEMA_AUTO_HEAL=true
# SCHEMA_BOOT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. WHATSAPP MESSAGING (Multi-Provider System)
# ------------------------------------------------------------------------------
# Active WhatsApp provider: kv_techmedia | meta_direct | twilio | mock | none
# - kv_techmedia : KV TechMedia Meta CRM API (production partner)
# - meta_direct  : Direct Meta Cloud API (WhatsApp Business Platform)
# - twilio       : Twilio Programmable Messaging (WhatsApp sandbox / live)
# - mock         : In-memory mock provider for local testing and CI
# - none         : Disabled (stub mode in dev, fails-closed in prod)
WHATSAPP_PROVIDER=none

# --- Provider Option A: KV TechMedia (Meta Partner) ---
# Required when WHATSAPP_PROVIDER=kv_techmedia:
KV_META_BASE_URL=https://crmapi.kvtmedia.com/api/meta
KV_META_API_VERSION=v19.0
KV_META_PHONE_NUMBER_ID=your-kv-phone-number-id
KV_META_ACCESS_TOKEN=your-kv-access-token
KV_META_APP_SECRET=your-kv-app-secret
KV_WEBHOOK_VERIFY_TOKEN=your-kv-webhook-verify-token
# Informational / display sender number
# KV_TECHMEDIA_WHATSAPP_NUMBER=919876543210

# --- Provider Option B: Meta Direct Cloud API ---
# Required when WHATSAPP_PROVIDER=meta_direct:
META_DIRECT_PHONE_NUMBER_ID=your-meta-phone-number-id
META_DIRECT_ACCESS_TOKEN=your-meta-system-user-access-token
META_DIRECT_APP_SECRET=your-meta-app-secret
META_DIRECT_VERIFY_TOKEN=your-meta-webhook-verify-token
META_WA_API_VERSION=v19.0
# Informational / display sender number
# META_WHATSAPP_PHONE_NUMBER=919876543210

# --- Provider Option C: Twilio WhatsApp ---
# Required when WHATSAPP_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+18382214175
# Comma-separated approved WhatsApp template names in Twilio Content API
# TWILIO_WA_TEMPLATES=auction_player_sold,match_update

# --- Common WhatsApp Settings & Workers ---
# Public image banner URL for the "auction_player_sold" template header
# Defaults to: {APP_URL}/assets/branding/player-sold-banner.jpg
# WHATSAPP_PLAYER_SOLD_IMAGE_URL=https://bidwar.in/assets/branding/player-sold-banner.jpg

# If true in production, the server aborts startup if the active WhatsApp provider's
# credentials fail validation. If false (default), server starts in degraded communication mode.
STRICT_WHATSAPP_STARTUP=false

# Background queue worker for retrying and dispatching queued communications
COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_POLL_MS=5000

# Testing only — allow mock provider in production (MUST remain false/omitted)
# ALLOW_MOCK_COMM_IN_PROD=false

# ------------------------------------------------------------------------------
# 4. SMS GATEWAY (BulkSMS / Fast2SMS DLT)
# ------------------------------------------------------------------------------
# BULKSMS_KEY and BULKSMS_PASSWORD are interchangeable (BULKSMS_KEY preferred)
BULKSMS_KEY=your-bulksms-key-or-fast2sms-key
# BULKSMS_PASSWORD=your-fast2sms-key
BULKSMS_SENDER=BIDWRR
BULKSMS_TEMPLATE_ID=your-dlt-otp-template-id
BULKSMS_PLAYER_SOLD_TEMPLATE_ID=your-dlt-player-sold-template-id
BULKSMS_TEAM_OWNER_TEMPLATE_ID=your-dlt-team-owner-template-id
BULKSMS_VIEWER_LINK_TEMPLATE_ID=your-dlt-viewer-link-template-id

# Set to true to force SMS OTP mode via BulkSMS instead of Twilio Verify
# SMS_OTP_ENABLED=true

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Resend)
# ------------------------------------------------------------------------------
# Toggle transactional email notifications
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=BidWar <noreply@mail.bidwar.in>

# ------------------------------------------------------------------------------
# 6. AI & LLM INTELLIGENCE (OpenAI)
# ------------------------------------------------------------------------------
# Enables automated post-match briefings and tournament analytics insights
OPENAI_API_KEY=sk-proj-your-openai-api-key
# LLM model identifier (default: gpt-4o-mini)
INTELLIGENCE_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 7. REDIS DISTRIBUTED LOCKS & PUB/SUB (Optional)
# ------------------------------------------------------------------------------
# Connection string for Redis. Used for cross-instance distributed locks and
# multi-node SSE broadcasts. If omitted, BidWar gracefully falls back to in-memory locks.
# REDIS_URL=redis://default:password@host:port

# ------------------------------------------------------------------------------
# 8. SCORER ACCOUNT BOOTSTRAPPING
# ------------------------------------------------------------------------------
# In production, seeds the first global scorer account if none exists.
# In local development, defaults automatically to 9999999999 / 1234.
# SCORER_BOOTSTRAP_MOBILE=9999999999
# SCORER_BOOTSTRAP_PIN=1234
# SCORER_BOOTSTRAP_NAME=Default Scorer

# ------------------------------------------------------------------------------
# 9. CLOUDINARY & IMAGE MEDIA PROCESSING
# ------------------------------------------------------------------------------
# Required for player photo uploads, sponsor banners, and team logos (returns 503 if missing)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Or use complete connection URL (starts with cloudinary://):
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Concurrency tuning for Sharp image processing and bulk photo imports
# SHARP_CONCURRENCY=2
# PHOTO_IMPORT_CONCURRENCY=1
# OG_IMAGE_CACHE_DIR=.og-image-cache

# ------------------------------------------------------------------------------
# 10. GOOGLE OAUTH (Organizer Sign-In)
# ------------------------------------------------------------------------------
# Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Google Search Console HTML meta tag verification token (client build)
VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-token

# ------------------------------------------------------------------------------
# 11. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Web Push for owner-app and scorer-app notifications
# Generate new pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ------------------------------------------------------------------------------
# 12. SECURITY, CAPTCHA & REPOSITORY AUTOMATION
# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA for organizer login protection (triggers on attempts 6–10)
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Restricted secondary admin password for data-export operations only
# ADMIN_DATA_PASSWORD=replace-with-export-only-password

# GitHub Personal Access Token with repo scope (used in Settings → Trigger Deploy Workflow)
# GITHUB_PAT=ghp_your_github_personal_access_token

# ------------------------------------------------------------------------------
# 13. RATE LIMITING CONFIGURATION
# ------------------------------------------------------------------------------
RATE_LIMIT_DISABLED=false
RATE_LIMIT_GLOBAL_MAX=2500
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_OTP_SEND_MAX=3
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_HEAVY_MAX=300
RATE_LIMIT_CHEER_MAX=30
RATE_LIMIT_PUSH_SUBSCRIBE_MAX=5
RATE_LIMIT_OWNER_LOOKUP_MAX=15
RATE_LIMIT_INSIGHTS_MAX=30
RATE_LIMIT_CONTACT_MAX=8

# ------------------------------------------------------------------------------
# 14. SPORTS SCORING & FEATURE FLAGS
# ------------------------------------------------------------------------------
# Enable sports scoring platform (cricket, badminton, multi-sport)
SCORING=true
# ENABLE_BADMINTON=true

# Verbose logging of scoring orchestrator events
# DEBUG_SCORING=false

# Multi-sport player specifications v2 (true by default)
# PLAYER_SPECS_V2_ENABLED=true
# PLAYER_SPORT_PROFILES_ENABLED=true

# Edge redirect of non-canonical domains to canonical host in express
# ENABLE_APP_HOST_REDIRECT=false

# Badminton latency probe tuning (Sprint 1 / C8)
# BIDWAR_LATENCY_PROBE_SECRET=
# BIDWAR_ALLOW_OPEN_LATENCY_PROBE=1
# BIDWAR_LATENCY_TRACE=false

# ------------------------------------------------------------------------------
# 15. LOCAL DEVELOPMENT & SPLIT-PROCESS DEV (pnpm dev)
# ------------------------------------------------------------------------------
# Used when running API and Vite frontends in split-process mode:
API_PORT=8080
WEB_PORT=24755
# FRONTEND_PORT=3000
# OWNER_APP_PORT=5174
# SCORING_APP_PORT=5175
# MOBILE_APP_PORT=5176
# DEV_ENABLE_SCORING=1
BASE_PATH=/

# Proxy targets for Vite dev server:
# API_DEV_PROXY_TARGET=http://127.0.0.1:8080
# VITE_DEV_API_TARGET=http://127.0.0.1:8080
# OWNER_APP_DEV_PROXY_TARGET=http://127.0.0.1:5174
# SCORING_APP_DEV_PROXY_TARGET=http://127.0.0.1:5175
# MOBILE_APP_DEV_PROXY_TARGET=http://127.0.0.1:5176

# Extra CORS origins for local LAN / tunnels / devices
# EXTRA_CORS_ORIGINS=http://192.168.1.100:3000

# Skip OTP verification during local development (startup aborts if set in production!)
# BYPASS_OTP=true

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 16. STANDALONE & DESKTOP APPS (Optional / Offline)
# ------------------------------------------------------------------------------
# bidwar-local Electron app SQLite database path:
# DB_PATH=./auction.db
# CLOUD_BASE_URL=https://bidwar.in
# LOCAL_SESSION_SECRET=your-local-desktop-secret
# Mobile app Capacitor origin:
# CAPACITOR_SERVER_URL=https://bidwar.in
