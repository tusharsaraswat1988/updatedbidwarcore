{
  "name": "BidWar Scoring Console",
  "short_name": "BidWar Scorer",
  "description": "Live match scoring console for cricket, badminton, and tournaments — BidWar",
  "start_url": "/scoring-app/cricket/scorer",
  "scope": "/scoring-app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#1b2044",
  "theme_color": "#1b2044",
  "icons": [
    {
      "src": "/scoring-app/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/scoring-app/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
