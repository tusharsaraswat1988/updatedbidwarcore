function validate_(p, c) { const mobile = /^[6-9]\d{9}$/, mail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; if (!p || p.tournamentSlug !== c.slug || !p.idempotencyKey) throw new Error('Invalid tournament request.'); if (!p.association || !p.association.name || !p.association.branch || !mail.test(p.association.email) || !mobile.test(p.association.mobile) || !file_(p.association.logo,c)) throw new Error('Invalid association details.'); const classes = c.categoryClasses[p.category]; if (!classes || !Array.isArray(p.players) || p.players.length !== c.playersPerTeam) throw new Error(`Exactly ${c.playersPerTeam} valid players are required.`); p.players.forEach((x,i) => { const required = c.roleRequiredFields[x.role]; if (!x.name || !classes.includes(x.className) || !x.dob || !mobile.test(x.parentMobile) || !mail.test(x.parentEmail) || !file_(x.photo,c) || !/^[1-9]\d?$/.test(String(x.jerseyNumber)) || !x.jerseySize || !required || required.some(key => !x.roleDetails || !x.roleDetails[key])) throw new Error('Invalid player details for Player '+(i+1)+'.'); }); if (!p.mentor || !p.mentor.name || !mobile.test(p.mentor.mobile) || (p.mentor.secondMobile && !mobile.test(p.mentor.secondMobile)) || !mail.test(p.mentor.email) || !file_(p.mentor.photo,c)) throw new Error('Invalid mentor details.'); if (!p.payment || typeof p.payment.brandingOpted !== 'boolean' || !String(p.payment.utr || '').trim() || !file_(p.payment.screenshot,c) || p.payment.registrationFee !== c.registrationFee || p.payment.brandingFee !== (p.payment.brandingOpted ? c.brandingFee : 0) || p.payment.totalAmount !== p.payment.registrationFee + p.payment.brandingFee) throw new Error('Invalid payment details.'); }
