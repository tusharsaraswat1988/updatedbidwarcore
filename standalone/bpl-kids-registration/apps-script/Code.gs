function doGet(e) { const c = config_(); if (e && e.parameter && e.parameter.action === 'getSettings') return output_({ success: true, settings: publicSettings_(c), open: isOpen_(c) }); return output_({ success: true, service: 'BPL Kids standalone registration endpoint', open: isOpen_(c) }); }
