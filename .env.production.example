# ==============================================================================
# BIDWAR — Production Environment Template (.env.production.example)
# ==============================================================================
# Copy this file to `.env.production` for local production testing (`pnpm start:prod`
# or `pnpm run db:setup:prod`).
#
# On hosting platforms (Render, Railway, Fly.io, VPS), configure these environment
# variables directly in your host dashboard. Never commit `.env.production` to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PRODUCTION RUNTIME (Required)
# ------------------------------------------------------------------------------
NODE_ENV=production
BIDWAR_ENV=production
SERVE_STATIC=true
PORT=3000

# Production PostgreSQL connection string (Neon pooled endpoint)
# MUST be a dedicated production database instance — never point to development or staging!
DATABASE_URL=postgresql://user:password@host.neon.tech/production-db?sslmode=require

# Direct compute connection string for Postgres LISTEN/NOTIFY and migrations
# (Automatically resolved by stripping '-pooler.' if omitted on Neon)
# DIRECT_DATABASE_URL=postgresql://user:password@host.neon.tech/production-db?sslmode=require

# Host allowlist safety guard: fails closed at boot if DATABASE_URL does not contain this substring
# NEON_PRODUCTION_HOST_ALLOWLIST=production-neon-host-substring
# NEON_STAGING_HOST_ALLOWLIST=staging-neon-host-substring

# Canonical domain configuration
# APP_DOMAIN apex + www required for cross-subdomain auth cookies
APP_DOMAIN=bidwar.in,www.bidwar.in
APP_URL=https://bidwar.in
APP_PUBLIC_SCHEME=https

# Optional extra CORS origins (production origins https://bidwar.in and Railway hosts are auto-whitelisted)
# CORS_ORIGINS=https://bidwar.in,https://www.bidwar.in

# Cryptographic secrets
# SESSION_SECRET: generate via `openssl rand -hex 32` (minimum 32 characters)
SESSION_SECRET=replace-with-32-byte-random-hex-minimum-32-chars
ADMIN_PASSWORD=replace-with-strong-production-admin-password
# Restricted password for data export operations only
# ADMIN_DATA_PASSWORD=replace-with-export-only-password

# Multi-sport platform scoring engine (Cricket, Badminton, etc.)
SCORING=true
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. WHATSAPP NOTIFICATIONS (Production Multi-Provider)
# ------------------------------------------------------------------------------
# Active provider: kv_techmedia | meta_direct | twilio | none
WHATSAPP_PROVIDER=kv_techmedia

# --- Option A: KV TechMedia (Meta Partner CRM API) ---
KV_META_BASE_URL=https://crmapi.kvtmedia.com/api/meta
KV_META_API_VERSION=v19.0
KV_META_PHONE_NUMBER_ID=your-production-kv-phone-number-id
KV_META_ACCESS_TOKEN=your-production-kv-access-token
KV_META_APP_SECRET=your-production-kv-app-secret
KV_WEBHOOK_VERIFY_TOKEN=your-production-kv-webhook-verify-token
# KV_TECHMEDIA_WHATSAPP_NUMBER=919876543210

# --- Option B: Meta Direct Cloud API ---
# META_DIRECT_PHONE_NUMBER_ID=your-meta-cloud-phone-number-id
# META_DIRECT_ACCESS_TOKEN=your-meta-system-user-access-token
# META_DIRECT_APP_SECRET=your-meta-app-secret
# META_DIRECT_VERIFY_TOKEN=your-meta-webhook-verify-token
# META_WA_API_VERSION=v19.0
# META_WHATSAPP_PHONE_NUMBER=919876543210

# --- Option C: Twilio WhatsApp ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-production-twilio-auth-token
# TWILIO_WHATSAPP_FROM=+18382214175
# TWILIO_WA_TEMPLATES=auction_player_sold

# --- WhatsApp Operational Controls ---
# Public header image for auction_player_sold utility template
WHATSAPP_PLAYER_SOLD_IMAGE_URL=https://bidwar.in/assets/branding/player-sold-banner.jpg

# Set true to abort server startup if WhatsApp provider configuration is invalid
STRICT_WHATSAPP_STARTUP=false

# Background queue worker for retrying and processing communications
COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_POLL_MS=5000

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_production_resend_api_key
MAIL_FROM=BidWar <noreply@mail.bidwar.in>

# ------------------------------------------------------------------------------
# 4. SMS GATEWAY (BulkSMS / Fast2SMS DLT)
# ------------------------------------------------------------------------------
BULKSMS_KEY=your-production-dlt-sms-api-key
BULKSMS_SENDER=BIDWRR
BULKSMS_TEMPLATE_ID=your-dlt-otp-template-id
BULKSMS_CONSENT_TEMPLATE_ID=your-dlt-consent-optin-template-id
BULKSMS_PLAYER_SOLD_TEMPLATE_ID=your-dlt-player-sold-template-id
BULKSMS_TEAM_OWNER_TEMPLATE_ID=your-dlt-team-owner-template-id
BULKSMS_VIEWER_LINK_TEMPLATE_ID=your-dlt-viewer-link-template-id

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH (Organizer Sign-In)
# ------------------------------------------------------------------------------
# Register redirect URI in Google Console: https://bidwar.in/api/auth/google/callback
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-production-google-client-secret
VITE_GOOGLE_SITE_VERIFICATION=your-google-search-console-verification-token

# ------------------------------------------------------------------------------
# 6. CLOUDINARY & IMAGE PROCESSING
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-production-cloud-name
CLOUDINARY_API_KEY=your-production-api-key
CLOUDINARY_API_SECRET=your-production-api-secret
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Sharp & Photo Import concurrency (tune for host RAM; default 2 threads / 1 bulk import)
SHARP_CONCURRENCY=2
PHOTO_IMPORT_CONCURRENCY=1

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your-production-vapid-public-key
VAPID_PRIVATE_KEY=your-production-vapid-private-key

# ------------------------------------------------------------------------------
# 8. AI INTELLIGENCE & LLM (OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-production-openai-api-key
INTELLIGENCE_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 9. REDIS DISTRIBUTED LOCKS & PUB/SUB (Optional / Multi-Instance)
# ------------------------------------------------------------------------------
# Required for multi-instance horizontal scaling (Render/Railway autoscaling)
# REDIS_URL=rediss://default:password@host:port

# ------------------------------------------------------------------------------
# 10. SCORER ACCOUNT BOOTSTRAP (First Deploy)
# ------------------------------------------------------------------------------
# Automatically seeds the first global scorer account if database has none
# SCORER_BOOTSTRAP_MOBILE=919876543210
# SCORER_BOOTSTRAP_PIN=9876
# SCORER_BOOTSTRAP_NAME=Tournament Scorer

# ------------------------------------------------------------------------------
# 11. SECURITY & CAPTCHA (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# GitHub Actions deploy trigger from Admin UI
# GITHUB_PAT=ghp_your_production_github_pat

# ------------------------------------------------------------------------------
# 12. PERFORMANCE & RATE LIMITING
# ------------------------------------------------------------------------------
PG_POOL_MAX=20
RATE_LIMIT_DISABLED=false
RATE_LIMIT_GLOBAL_MAX=2500
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_OTP_SEND_MAX=3
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_HEAVY_MAX=300
RATE_LIMIT_CHEER_MAX=30
RATE_LIMIT_PUSH_SUBSCRIBE_MAX=5
RATE_LIMIT_OWNER_LOOKUP_MAX=15
RATE_LIMIT_INSIGHTS_MAX=30
RATE_LIMIT_CONTACT_MAX=8

# ------------------------------------------------------------------------------
# 13. MULTI-SPORT FEATURE FLAGS
# ------------------------------------------------------------------------------
PLAYER_SPECS_V2_ENABLED=true
PLAYER_SPORT_PROFILES_ENABLED=true
